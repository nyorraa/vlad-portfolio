---
import Icon from '../ui/Icon.astro';

interface Activity {
  id: string;
  icon: string;
  label: string;
  active?: boolean;
}

const activities: Activity[] = [
  { id: 'files', icon: '/activity-bar/file-svgrepo-com.svg', label: 'Explorer', active: true },
  { id: 'python', icon: '/activity-bar/python-svgrepo-com.svg', label: 'Python' },
  { id: 'git', icon: '/activity-bar/git.svg', label: 'Source Control' },
  { id: 'search', icon: '/activity-bar/search-alt-1-svgrepo-com.svg', label: 'Search' },
];

const settingsIcon = '/activity-bar/settings-svgrepo-com (1).svg';
---

<aside class="activity-bar">
  <div class="activity-top">
    {activities.map(({ id, icon, label, active }) => (
      <button
        class:list={['btn-activity', { active }]}
        aria-label={label}
        data-activity={id}
      >
        <Icon src={icon} alt={label} size={30} />
      </button>
    ))}
  </div>
  <div class="activity-bottom">
    <button class="btn-activity" aria-label="Settings">
      <Icon src={settingsIcon} alt="settings" size={30} />
    </button>
  </div>
</aside>

<style>
  .activity-bar {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: var(--activity-bar-width);
    height: 100%;
    background-color: var(--bg-activity-bar);
    border-right: var(--border-width) solid var(--border-color);
    padding: var(--spacing-md) 0;
    box-sizing: border-box;
  }

  .activity-top,
  .activity-bottom {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-lg);
  }

  .btn-activity {
    background: transparent;
    border: none;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    opacity: 0.7;
    transition: opacity var(--transition-fast), background-color var(--transition-fast);
    border-radius: var(--radius-sm);
    position: relative;
  }

  .btn-activity:hover {
    opacity: 1;
    background-color: var(--bg-hover);
  }

  .btn-activity.active {
    opacity: 1;
  }

  .btn-activity.active::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 2px;
    height: 24px;
    background-color: var(--accent-primary);
  }
</style>
