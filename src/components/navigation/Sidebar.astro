---
// Боковая панель с категориями и топовыми проектами

interface Category {
  id: string;
  label: string;
  active?: boolean;
}

interface Project {
  id: string;
  name: string;
  icon?: string;
}

const categories: Category[] = [
  { id: 'all', label: 'All Projects', active: true },
  { id: 'leetcode', label: 'LeetCode & Alg' },
  { id: 'sql', label: 'SQL & DB' },
  { id: '3d', label: '3D Graphics' },
];

const topProjects: Project[] = [
  { id: 'overlimit', name: 'Overlimit' },
  { id: 'knowledge-hub', name: 'Knowledge Hub' },
  { id: 'lawyer-bot', name: 'Lawyer_tg_bot' },
];
---

<aside class="sidebar">
  <!-- CATEGORIES SECTION -->
  <div class="nav-section">
    <div class="section-header"># Categories</div>
    <div class="section-body">
      {categories.map(({ id, label, active }) => (
        <button
          class:list={['btn-nav', { active }]}
          data-category={id}
        >
          <span class="icon">{active ? '[▪]' : '[ ]'}</span>
          {label}
        </button>
      ))}
    </div>
  </div>

  <!-- TOP PROJECTS SECTION -->
  <div class="nav-section">
    <div class="section-header"># Top Projects</div>
    <div class="section-body">
      {topProjects.map(({ id, name }) => (
        <button class="btn-project" data-project={id}>
          <span class="icon-arrow">▸</span>
          {name}
        </button>
      ))}
    </div>
  </div>
</aside>

<style>
  .sidebar {
    display: flex;
    flex-direction: column;
    gap: 25px;
    width: var(--sidebar-width);
    height: 100%;
    background-color: var(--bg-sidebar);
    padding: var(--spacing-xl) var(--spacing-lg);
    box-sizing: border-box;
    border-right: var(--border-width) solid var(--border-color);
    overflow-y: auto;
  }

  .nav-section {
    display: flex;
    flex-direction: column;
  }

  .section-header {
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-bold);
    color: var(--color-comment);
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: var(--spacing-sm);
    padding-left: 5px;
  }

  .section-body {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
  }

  .btn-nav,
  .btn-project {
    width: 100%;
    height: 32px;
    background: transparent;
    border: none;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
    text-align: left;
    padding: 0 var(--spacing-md);
    cursor: pointer;
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    transition: background-color var(--transition-fast), color var(--transition-fast);
  }

  .btn-nav:hover,
  .btn-project:hover {
    background-color: var(--bg-hover);
    color: var(--color-text-primary);
  }

  .btn-nav.active {
    background-color: var(--accent-primary);
    color: var(--color-text-primary);
  }

  .icon {
    color: var(--accent-primary);
    font-weight: var(--font-weight-bold);
  }

  .btn-nav:hover .icon {
    color: var(--color-text-primary);
  }

  .btn-nav.active .icon {
    color: var(--color-text-primary);
  }

  .icon-arrow {
    color: #888888;
    transition: transform var(--transition-fast), color var(--transition-fast);
  }

  .btn-project:hover .icon-arrow {
    color: var(--color-comment);
    transform: translateX(2px);
  }

  @media (max-width: 900px) {
    .sidebar {
      display: none;
    }
  }
</style>
