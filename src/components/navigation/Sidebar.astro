---
interface All {
  id: string;
  label: string;
}

interface Project {
  id: string;
  name: string;
  icon?: string;
}

interface Category {
  id: string;
  label: string;
  active?: boolean;
}

const allProjects: All[] = [
  { label: 'All Projects' },
]

const topProjects: Project[] = [
  { id: 'overlimit', name: 'Overlimit' },
  { id: 'knowledge-hub', name: 'Knowledge Hub' },
  { id: 'lawyer-bot', name: 'Lawyer_tg_bot' },
];

const categories: Category[] = [
  { id: 'sql', label: 'SQL & DB / mb CERTIFICATES or Achievement' },
  { id: '3d', label: '3D Graphics' },
  { id: 'leetcode', label: 'LeetCode' },
];
---

<aside class="sidebar">
  <!-- ALL PROJECTS SECTION -->
  <div class="nav-section">
    <div class="section-body">
      {allProjects.map(({ id, label }) => (
        <button class="btn-all-project" data-project={id}>
        {label}
        </button>
      ))}
    </div>
  </div>

  <!-- TOP PROJECTS SECTION -->
  <div class="nav-section">
    <div class="section-header"># Top Projects</div>
    <div class="section-body">
      {topProjects.map(({ id, name }) => (
        <button class="btn-project" data-project={id}>
          <span class="icon-arrow">▸</span>
          {name}
        </button>
      ))}
    </div>
  </div>

  <!-- TOP CATEGORIES SECTION -->
  <div class="nav-section">
    <div class="section-header"># Categories</div>
    <div class="section-body">
      {categories.map(({ id, label }) => (
        <button class="btn-categories" data-category={id}>
          <span class="icon-arrow">▸</span>
          {label}
        </button>
      ))}
    </div>
  </div>
</aside>

<style>
  .sidebar {
    display: flex;
    flex-direction: column;
    gap: 25px;
    width: var(--sidebar-width);
    height: 100%;
    background-color: var(--bg-sidebar);
    padding: var(--spacing-xl) var(--spacing-lg);
    box-sizing: border-box;
    border-right: var(--border-width) solid var(--border-color);
    overflow-y: auto;
  }

  .nav-section {
    display: flex;
    flex-direction: column;
  }

  .section-header {
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-bold);
    color: var(--color-comment);
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: var(--spacing-sm);
    padding-left: 5px;
  }

  .section-body {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
  }

  .btn-all-project {
    width: calc(100% - calc(var(--spacing-md) * 2));
    margin: 0 auto var(--spacing-lg) auto;
    height: 44px;
    padding: 0 var(--spacing-lg);
    background: transparent;
    border: 1px solid var(--accent-primary);
    border-radius: var(--radius-md);
    color: var(--accent-primary);
    font-family: var(--font-mono);
    font-size: var(--font-size-md);
    font-weight: 600;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-sm);
    cursor: pointer;
    transition: background-color var(--transition-fast), border-color var(--transition-fast), color var(--transition-fast);
  }

  .btn-all-project:hover {
    background-color: var(--accent-primary);
    color: var(--bg-primary);
    border-color: var(--accent-hover);
  }


  .btn-project,
  .btn-categories
   {
    width: 100%;
    height: 32px;
    background: transparent;
    border: none;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
    text-align: left;
    padding: 0 var(--spacing-md);
    cursor: pointer;
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    transition: background-color var(--transition-fast), color var(--transition-fast);
  }

  .btn-categories:hover,
  .btn-project:hover {
    background-color: var(--bg-hover);
    color: var(--color-text-primary);
  }

  .icon-arrow {
    color: #888888;
    transition: transform var(--transition-fast), color var(--transition-fast);
  }

  .btn-project:hover .icon-arrow {
    color: var(--color-comment);
    transform: translateX(2px);
  }

  @media (max-width: 900px) {
    .sidebar {
      display: none;
    }
  }
</style>
