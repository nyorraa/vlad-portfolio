---
interface Props {
  src: string;
  alt: string;
  size?: number;
}

const { src, alt, size = 24 } = Astro.props;
---

<img
  src={src}
  alt={alt}
  width={size}
  height={size}
  class="icon"
/>

<style>
  .icon {
    display: block;
    width: var(--size);
    height: var(--size);
    object-fit: contain;
  }
</style>
