---
// Contact секция с ссылками на социальные сети и email
---

<section id="contact" class="section-contact">
  <h2 class="section-title"># Contacts</h2>
  <div class="contacts-container">
    <div class="contact-item">
      <strong class="contact-label">Telegram:</strong>
      <a
        href="https://t.me/nyorraa"
        target="_blank"
        rel="noopener noreferrer"
        class="contact-link"
      >
        @nyorraa
      </a>
    </div>

    <div class="contact-item">
      <strong class="contact-label">Email:</strong>
      <a
        href="mailto:vlad1slav200508@yandex.ru"
        class="contact-link"
      >
        vlad1slav200508@yandex.ru
      </a>
    </div>

    <div class="contact-item">
      <strong class="contact-label">GitHub:</strong>
      <a
        href="https://github.com/nyorraa"
        target="_blank"
        rel="noopener noreferrer"
        class="contact-link"
      >
        github.com/nyorraa
      </a>
    </div>
  </div>
</section>

<style>
  .section-contact {
    min-height: 85vh;
    margin-bottom: var(--spacing-3xl);
    scroll-margin-top: var(--tab-bar-height);
  }

  .section-title {
    color: var(--color-comment);
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-bold);
    margin-bottom: var(--spacing-xl);
  }

  .contacts-container {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-lg);
  }

  .contact-item {
    font-size: var(--font-size-md);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-secondary);
  }

  .contact-label {
    color: var(--accent-primary);
    display: inline-block;
    margin-right: var(--spacing-sm);
    font-weight: var(--font-weight-bold);
  }

  .contact-link {
    color: var(--color-text-primary);
    text-decoration: none;
    border-bottom: 1px dashed var(--color-comment);
    transition: color var(--transition-fast), border-color var(--transition-fast);
  }

  .contact-link:hover {
    color: var(--color-comment);
    border-color: var(--accent-primary);
  }
</style>
