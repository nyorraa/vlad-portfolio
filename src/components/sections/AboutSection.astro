---
import AvatarCard from '../ui/AvatarCard.astro';
import Badge from '../ui/Badge.astro';
import { getTranslations, getCurrentLanguage } from '../../i18n/utils';

const lang = getCurrentLanguage();
const t = getTranslations(lang);
---

<section id="about" class="section-about">
  <div class="about-layout">
    <div class="about-text">
      <h2 class="section-title">{t.about.title}</h2>
      <h1 class="dev-title">
        {t.about.jobTitle} <Badge variant="primary" text={t.about.badge} />
      </h1>
      <div class="dev-description">
        {t.about.description.map((paragraph, i) => (
          <p set:html={paragraph} class:list={[{ 'mt': i > 0 }]} />
        ))}
      </div>
    </div>

    <AvatarCard
      imageSrc="/images/human-handsup-svgrepo-com.svg"
      imageAlt="Vlad - Backend Engineer"
      caption={t.about.avatarCaption}
    />
  </div>
</section>

<style>
  .section-about {
    min-height: 85vh;
    margin-bottom: var(--spacing-3xl);
    border-bottom: 1px dashed var(--border-subtle);
    scroll-margin-top: var(--tab-bar-height);
    padding-top: var(--spacing-md);
  }

  .about-layout {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--spacing-3xl);
  }

  .about-text {
    flex: 1;
  }

  .section-title {
    color: var(--color-comment);
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-bold);
    margin-bottom: var(--spacing-md);
  }

  .dev-title {
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
    margin: var(--spacing-md) 0 var(--spacing-xl) 0;
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
    flex-wrap: wrap;
  }

  .dev-description {
    color: var(--color-text-secondary);
    font-size: var(--font-size-md);
    line-height: var(--line-height-normal);
    max-width: 600px;
  }

  .dev-description p {
    margin: 0;
  }

  .dev-description p.mt {
    margin-top: var(--spacing-lg);
  }

  .dev-description strong {
    color: var(--color-keyword);
    font-weight: var(--font-weight-bold);
  }

  .dev-description :global(.badge-danger) {
    display: inline-block;
    padding: 2px 8px;
    background-color: var(--accent-danger);
    color: var(--color-text-primary);
    border-radius: var(--radius-sm);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-bold);
  }

  @media (max-width: 900px) {
    .about-layout {
      flex-direction: column-reverse;
      align-items: center;
      text-align: center;
    }

    .dev-title {
      justify-content: center;
    }

    .dev-description {
      margin: 0 auto;
    }
  }
</style>
