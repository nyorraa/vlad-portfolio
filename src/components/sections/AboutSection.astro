---
import AvatarCard from '../ui/AvatarCard.astro';
import Badge from '../ui/Badge.astro';
---

<section id="about" class="section-about">
  <div class="about-layout">
    <div class="about-text">
      <h2 class="section-title"># About Me</h2>
      <h1 class="dev-title">
        BACKEND <Badge variant="primary" text="Engineer" />
      </h1>
      <p class="dev-description">
        Backend Software Engineer specializing in production-ready Python development.
        Experienced in architecting fault-tolerant APIs (Modular Monoliths / Microservices),
        event-driven systems, real-time voice stacks, and production LLM integrations using RAG patterns.
        <br /><br />
        Deeply focused on algorithm optimization, complex SQL performance tuning, and low-latency
        database design. Can deploy apps on linux server, and support/expand them.
        <br /><br />
        Leveraging <strong>C#</strong> as a secondary language for systems programming and gameplay engineering.
        In my spare time, I develop <Badge variant="danger" text="OVERLIMIT" />—a custom arcade racing
        simulator built with <strong>Unity and C#</strong>, applying advanced OOP principles, custom physics,
        and rigorous code optimization. I maintain an active, clean, and production-grade codebase across
        all public repositories on GitHub.
      </p>
    </div>

    <AvatarCard
      imageSrc="/images/human-handsup-svgrepo-com.svg"
      imageAlt="Vlad - Backend Engineer"
      caption="vlad_portfolio.dev"
    />
  </div>
</section>

<style>
  .section-about {
    min-height: 85vh;
    margin-bottom: var(--spacing-3xl);
    border-bottom: 1px dashed var(--border-subtle);
    scroll-margin-top: var(--tab-bar-height);
    padding-top: var(--spacing-md);
  }

  .about-layout {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--spacing-3xl);
  }

  .about-text {
    flex: 1;
  }

  .section-title {
    color: var(--color-comment);
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-bold);
    margin-bottom: var(--spacing-md);
  }

  .dev-title {
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
    margin: var(--spacing-md) 0 var(--spacing-xl) 0;
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
    flex-wrap: wrap;
  }

  .dev-description {
    color: var(--color-text-secondary);
    font-size: var(--font-size-md);
    line-height: var(--line-height-normal);
    max-width: 600px;
  }

  .dev-description strong {
    color: var(--color-keyword);
    font-weight: var(--font-weight-bold);
  }

  @media (max-width: 900px) {
    .about-layout {
      flex-direction: column-reverse;
      align-items: center;
      text-align: center;
    }

    .dev-title {
      justify-content: center;
    }

    .dev-description {
      margin: 0 auto;
    }
  }
</style>
