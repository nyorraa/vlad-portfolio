---
// Tech Stack секция с категориями технологий
---

<section id="stack" class="section-stack">
  <h2 class="section-title"># Tech Stack</h2>
  <div class="stack-container">
    <div class="stack-category">
      <strong class="category-label">Core & Backend:</strong>
      <span class="category-content">Python 3.11+, asyncio, FastAPI, Pydantic, Swagger, uv, Logging, Pytest</span>
    </div>

    <div class="stack-category">
      <strong class="category-label">AI & Machine Learning:</strong>
      <span class="category-content">AI Agents & LLM, RAG Architecture, LangChain, Ollama, Vector Databases, Machine Learning, pandas</span>
    </div>

    <div class="stack-category">
      <strong class="category-label">Architecture & Data:</strong>
      <span class="category-content">High-load Systems, Microservices Architecture, Database Design, PostgreSQL, MySQL, Redis, Celery, Alembic, Payment Integration</span>
    </div>

    <div class="stack-category">
      <strong class="category-label">DevOps & Infrastructure:</strong>
      <span class="category-content">Docker, Docker-compose, CI/CD, Git, Linux</span>
    </div>

    <div class="stack-category">
      <strong class="category-label">Hobby / Second Language:</strong>
      <span class="category-content">C#, Unity Game Engine</span>
    </div>
  </div>
</section>

<style>
  .section-stack {
    min-height: 85vh;
    margin-bottom: var(--spacing-3xl);
    border-bottom: 1px dashed var(--border-subtle);
    scroll-margin-top: var(--tab-bar-height);
  }

  .section-title {
    color: var(--color-comment);
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-bold);
    margin-bottom: var(--spacing-xl);
  }

  .stack-container {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-lg);
  }

  .stack-category {
    font-size: var(--font-size-md);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-secondary);
  }

  .category-label {
    color: var(--accent-primary);
    display: inline-block;
    margin-right: var(--spacing-sm);
    font-weight: var(--font-weight-bold);
  }

  .category-content {
    color: var(--color-text-secondary);
  }
</style>
