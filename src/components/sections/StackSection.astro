---
import { getTranslations, getCurrentLanguage } from '../../i18n/utils';

interface Props {
  cookieHeader?: string;
}

const { cookieHeader } = Astro.props;
const lang = getCurrentLanguage(cookieHeader);
const t = getTranslations(lang);
---

<section id="stack" class="section-stack">
  <h2 class="section-title">{t.stack.title}</h2>
  <div class="stack-container">
    <div class="stack-category">
      <strong class="category-label">{t.stack.backend.title}:</strong>
      <span class="category-content">{t.stack.backend.items.join(', ')}</span>
    </div>

    <div class="stack-category">
      <strong class="category-label">{t.stack.databases.title}:</strong>
      <span class="category-content">{t.stack.databases.items.join(', ')}</span>
    </div>

    <div class="stack-category">
      <strong class="category-label">{t.stack.tools.title}:</strong>
      <span class="category-content">{t.stack.tools.items.join(', ')}</span>
    </div>

    <div class="stack-category">
      <strong class="category-label">{t.stack.other.title}:</strong>
      <span class="category-content">{t.stack.other.items.join(', ')}</span>
    </div>

    <div class="stack-category">
      <strong class="category-label">{t.stack.hobby.title}:</strong>
      <span class="category-content">{t.stack.hobby.items.join(', ')}</span>
    </div>
  </div>
</section>

<style>
  .section-stack {
    min-height: 85vh;
    margin-bottom: var(--spacing-3xl);
    border-bottom: 1px dashed var(--border-subtle);
    scroll-margin-top: var(--tab-bar-height);
  }

  .section-title {
    color: var(--color-comment);
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-bold);
    margin-bottom: var(--spacing-xl);
  }

  .stack-container {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-lg);
  }

  .stack-category {
    font-size: var(--font-size-md);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-secondary);
  }

  .category-label {
    color: var(--accent-primary);
    display: inline-block;
    margin-right: var(--spacing-sm);
    font-weight: var(--font-weight-bold);
  }

  .category-content {
    color: var(--color-text-secondary);
  }
</style>
