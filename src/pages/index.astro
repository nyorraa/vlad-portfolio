---
import BaseLayout from '../layouts/BaseLayout.astro';
import WindowHeader from '../components/header/WindowHeader.astro';
import ActivityBar from '../components/navigation/ActivityBar.astro';
import Sidebar from '../components/navigation/Sidebar.astro';
import TabBar from '../components/ui/TabBar.astro';
import AboutSection from '../components/sections/AboutSection.astro';
import StackSection from '../components/sections/StackSection.astro';
import ContactSection from '../components/sections/ContactSection.astro';
import { getTranslations, getCurrentLanguage } from '../i18n/utils';

const cookieHeader = Astro.request.headers.get('cookie');
const lang = getCurrentLanguage(cookieHeader);
const t = getTranslations(lang);

const tabs = [
  { id: 'about', label: t.tabs.about, href: '#about' },
  { id: 'stack', label: t.tabs.stack, href: '#stack' },
  { id: 'contact', label: t.tabs.contact, href: '#contact' },
];
---

<BaseLayout title="Vlad | Backend Engineer Portfolio">
  <WindowHeader />

  <div class="workspace">
    <ActivityBar />
    <Sidebar />

    <main class="main-zone">
      <TabBar tabs={tabs} />

      <div class="scrollable-content">
        <AboutSection cookieHeader={cookieHeader} />
        <StackSection cookieHeader={cookieHeader} />
        <ContactSection cookieHeader={cookieHeader} />
      </div>
    </main>
  </div>
</BaseLayout>

<style>
  .workspace {
    display: flex;
    flex: 1;
    overflow: hidden;
  }

  .main-zone {
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .scrollable-content {
    flex: 1;
    overflow-y: auto;
    scroll-behavior: smooth;
    padding: var(--spacing-2xl);
    box-sizing: border-box;
  }
</style>