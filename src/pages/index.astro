---
import BaseLayout from '../layouts/BaseLayout.astro';
import WindowHeader from '../components/header/WindowHeader.astro';
import ActivityBar from '../components/navigation/ActivityBar.astro';
import Sidebar from '../components/navigation/Sidebar.astro';
import TabBar from '../components/ui/TabBar.astro';
import AboutSection from '../components/sections/AboutSection.astro';
import StackSection from '../components/sections/StackSection.astro';
import ContactSection from '../components/sections/ContactSection.astro';

const tabs = [
  { id: 'about', label: 'ABOUT ME', href: '#about' },
  { id: 'stack', label: 'STACK', href: '#stack' },
  { id: 'contact', label: 'CONTACT', href: '#contact' },
];
---

<BaseLayout title="Vlad | Backend Engineer Portfolio">
  <WindowHeader />

  <div class="workspace">
    <ActivityBar />
    <Sidebar />

    <main class="main-zone">
      <TabBar tabs={tabs} />

      <div class="scrollable-content">
        <AboutSection />
        <StackSection />
        <ContactSection />
      </div>
    </main>
  </div>
</BaseLayout>

<style>
  .workspace {
    display: flex;
    flex: 1;
    overflow: hidden;
  }

  .main-zone {
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .scrollable-content {
    flex: 1;
    overflow-y: auto;
    scroll-behavior: smooth;
    padding: var(--spacing-2xl);
    box-sizing: border-box;
  }
</style>
